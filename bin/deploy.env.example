# SFTP upload settings for bin/build-zip.command.
#
# Copy this file to bin/deploy.env (which is gitignored) and fill in your values.
# bin/build-zip.command reads it to upload the built zip to the wp-update-server.
# Never commit bin/deploy.env; it holds host/credential details.

# --- Connection --------------------------------------------------------------
DEPLOY_HOST="sftp.omegabenefits.net"
DEPLOY_USER="your-sftp-user"
DEPLOY_PORT="22"

# --- Authentication (pick ONE) ----------------------------------------------
DEPLOY_SSH_KEY="$HOME/.ssh/id_ed25519"
#DEPLOY_PASS="your-password"

# --- Remote destination ------------------------------------------------------
DEPLOY_REMOTE_DIR="/home/your-sftp-user/wp-update-server/packages"
DEPLOY_REMOTE_FILENAME="omega-cody.zip"

# Optional metadata URL override.
#DEPLOY_METADATA_URL="https://omegabenefits.net/wp-update-server/?action=get_metadata&slug=omega-cody"
